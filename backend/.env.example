# HTTP server
PORT=5000
NODE_ENV=development

# MongoDB connection string (required)
MONGODB_URI=mongodb://127.0.0.1:27017/kazilink

# Use different random secrets of at least 32 characters in each environment.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Exact browser origin allowed by CORS (Vite defaults to port 5173).
CLIENT_URL=http://localhost:5173

# Optional operational settings
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
